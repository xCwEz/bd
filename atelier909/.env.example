# Copier en .env.local (jamais commité) et renseigner de vraies valeurs.

# Mot de passe du back-office (/admin). À changer avant tout déploiement.
ADMIN_PASSWORD=change-me

# Secret utilisé pour signer le cookie de session admin.
ADMIN_SESSION_SECRET=change-me-aussi

# Token du bot Telegram (@BotFather). Nécessaire pour vérifier initData
# côté serveur et envoyer les notifications de vente.
TELEGRAM_BOT_TOKEN=

# Identifiant de conversation Telegram de l'opérateur (chat_id), pour
# recevoir la notification à chaque rendez-vous confirmé. Le bot doit avoir
# reçu au moins un message de ce compte pour pouvoir lui écrire.
TELEGRAM_OPERATOR_CHAT_ID=

# Clé de chiffrement des photos de pièce d'identité (AES-256-GCM). Chaîne
# longue et aléatoire — ex. `openssl rand -hex 32`. La perdre rend les
# photos déjà envoyées indéchiffrables ; la changer invalide celles en
# attente de validation. Ne jamais versionner cette valeur.
IDENTITE_CHIFFREMENT_CLE=
